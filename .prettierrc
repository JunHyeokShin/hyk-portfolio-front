{
  "printWidth": 120,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/_app",
    "^@/_pages",
    "^@/features",
    "^@/entities",
    "^@/shared",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "5.0.0"
}
